{
  "entity": {
    "event": {
      "activity": {
        "default": "mdi:door-closed-lock"
      }
    },
    "sensor": {
      "last_action": {
        "default": "mdi:lock-clock",
        "state": {
          "lock": "mdi:lock",
          "unlock": "mdi:lock-open-variant"
        }
      },
      "last_source": {
        "default": "mdi:gesture-tap",
        "state": {
          "keypad": "mdi:dialpad",
          "fingerprint": "mdi:fingerprint",
          "rfid": "mdi:nfc-variant",
          "zigbee": "mdi:zigbee",
          "auto": "mdi:timer-lock-outline"
        }
      },
      "last_user": {
        "default": "mdi:account-key"
      },
      "pin_codes": {
        "default": "mdi:form-textbox-password"
      },
      "pin_capacity": {
        "default": "mdi:numeric"
      },
      "last_report": {
        "default": "mdi:access-point-check"
      },
      "parent_router": {
        "default": "mdi:router-wireless"
      }
    },
    "switch": {
      "auto_relock": {
        "default": "mdi:lock-clock"
      },
      "keypad_programming": {
        "default": "mdi:dialpad",
        "state": {
          "off": "mdi:lock-outline"
        }
      }
    },
    "select": {
      "sound_volume": {
        "default": "mdi:volume-high",
        "state": {
          "off": "mdi:volume-off",
          "low": "mdi:volume-low",
          "normal": "mdi:volume-high"
        }
      }
    },
    "binary_sensor": {
      "battery_low": {
        "default": "mdi:battery-alert"
      }
    }
  },
  "services": {
    "set_pin": {
      "service": "mdi:form-textbox-password"
    },
    "clear_pin": {
      "service": "mdi:lock-remove"
    },
    "set_slot_name": {
      "service": "mdi:account-edit"
    },
    "enroll_credential": {
      "service": "mdi:card-account-details-outline"
    },
    "remove_credential": {
      "service": "mdi:card-remove-outline"
    }
  }
}
